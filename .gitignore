.venv/
data_cache/
data/vintages/
__pycache__/
*.pyc
.pytest_cache/
.gstack/
legacy/
.claude/

# RAG corpus — libros con copyright y su índice vectorial. Nunca al repo público.
data/rag/
data/crack23/
*.db
*.db-wal
*.db-shm

# Local book acquisition/probe records may contain source-text anchors.
# Keep these alongside the private corpus, outside both public deployments.
docs/eval/rag-book-additions-*.json
docs/eval/rag-staged-book-probes-*.json
docs/eval/rag-staged-books-*.json

# Superseded local screenshots are not part of the reviewed presentation.
docs/deck/media/_archive/

# Secrets — never committed. ANTHROPIC_API_KEY lives here for local runs.
.env
.env.*
!.env.example

# Cualquier hoja con credenciales queda fuera del control de versiones. El
# corpus se sirve hoy abierto y no hay token que repartir, pero el patrón se
# conserva: este repositorio es público y un secreto en su historial queda
# quemado aunque un commit posterior lo borre.
*.secreto.md

# Los .docx se regeneran desde el Markdown con tools/md_a_docx.py. El Markdown
# es la fuente, es el que se revisa y es el que tiene sus cifras comprobadas
# contra el motor. Versionar los dos invita a que digan cosas distintas.
docs/*.docx

# La presentación del front-end se regenera desde las capturas del sitio
# desplegado con tools/build_deck_frontend.py.
docs/Presentacion_frontend.pptx
